# Hermes — secrets template. Copied (with substitutions) to ~/.hermes/.env by
# setup.sh. After install: edit ~/.hermes/.env directly, never commit.
#
# Keys are read by `hermes` and by the systemd --user gateway unit (via
# EnvironmentFile=). Quoting follows systemd EnvironmentFile rules: values
# may be quoted with double quotes; no shell expansion happens.

# ---- LLM providers (setup.sh fills these from /opt/brein/.env) -------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: OpenRouter as a fallback / multi-model router. Leave blank to skip.
OPENROUTER_API_KEY=

# ---- Telegram gateway ------------------------------------------------------
# Token from @BotFather. Required for `hermes gateway --platform telegram`.
TELEGRAM_BOT_TOKEN=

# Comma-separated allowlist of Telegram user IDs that may DM the bot.
# Get your own ID by DMing @userinfobot. CRITICAL: without this anyone who
# guesses the bot username can chat (and bill your API keys). The gateway
# unit enforces this via the HERMES_TELEGRAM_USER_ALLOWLIST env var below.
TELEGRAM_ALLOWED_USER_IDS=
HERMES_TELEGRAM_USER_ALLOWLIST=${TELEGRAM_ALLOWED_USER_IDS}

# ---- Hermes runtime --------------------------------------------------------
# Suppress the "share telemetry?" prompt on first run.
HERMES_TELEMETRY=0
